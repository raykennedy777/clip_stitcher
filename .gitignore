.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
xcuserdata/
*.moved-aside

# Generated by XcodeGen (regenerated from project.yml)
*.xcodeproj/
/Generated/

# Swift Package Manager
.build/
.swiftpm/

# Node / Electron (if used for GUI)
node_modules/
dist/
out/
*.log

# Python (if smartcut is bundled/ported)
__pycache__/
*.py[cod]
.venv/
venv/

# Media work files / large samples
*.mp4
*.mov
*.mkv
*.m4v
*.avi
*.webm
tmp/
samples/
scratch_screenshots/

# Env
.env
.env.local

# Local signing override (see Config/Local.xcconfig.example)
Config/Local.xcconfig

# Agent tooling — third-party installed skills stay local, while repo-owned skills
# (such as delete-comment) are explicitly un-ignored below.
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/delete-comment/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/delete-comment
skills-lock.json
